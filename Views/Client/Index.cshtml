@model IEnumerable<Finders.Models.ClientModel>

@{
    ViewData["Title"] = "Clients";
}

<style>
    h2 {
        text-align: center;
        color: #333;
        margin-bottom: 30px;
    }

    .my-table {
        width: 100%;
        border-collapse: collapse;
        border-radius: 5px;
        overflow: hidden;
        box-shadow: 0px 0px 10px 0px rgba(0, 0, 0, 0.1);
    }

        .my-table th, .my-table td {
            padding: 15px;
            text-align: left;
            border-bottom: 1px solid #ddd;
        }

        .my-table th {
            background-color: gray;
            color: #fff;
        }

        .my-table tbody tr:nth-child(even) {
            background-color: #f2f2f2;
        }

        .my-table tbody tr:hover {
            background-color: #e9ecef;
        }

    .search-container {
        display: flex;
        justify-content: center;
        margin-bottom: 20px;
    }

    .search-input {
        padding: 10px;
        width: 300px;
        border: 1px solid #ddd;
        border-radius: 5px;
    }

    .search-button {
        padding: 10px 15px;
        margin-left: 10px;
        background-color: gray;
        color: white;
        border: none;
        border-radius: 5px;
        cursor: pointer;
    }

    .btn-back {
        padding: 10px 15px;
        margin-left: 10px;
        background-color: gray;
        color: white;
        border: none;
        border-radius: 5px;
        cursor: pointer;
    }

    .search-button:hover {
        background-color: #555;
    }

    /* Pagination buttons */
    .pagination-buttons {
        text-align: center;
        margin: 20px 0;
    }

        .pagination-buttons button {
            padding: 10px 20px;
            background-color: gray;
            color: white;
            border: none;
            margin: 0 5px;
            cursor: pointer;
            border-radius: 5px;
        }

            .pagination-buttons button[disabled] {
                background-color: lightgray;
                cursor: not-allowed;
            }
</style>

<h2>Client Database</h2>

<!-- Search Form -->
<div class="search-container">
    <form asp-action="Index" method="get">
        <input type="text" name="searchSurname" class="search-input" placeholder="Search by Surname" value="@ViewData["CurrentFilter"]" />
        <button type="submit" class="search-button">Search</button>
    </form>
    <form asp-action="Index" method="get">
        <button type="submit" class="btn-back">Back</button>
    </form>
</div>

<table class="table my-table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Surname</th>
            <th>Email</th>
            <th>Address</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody id="clientTable">
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @if (item.Photo == null)
                    {
                        <img src="@item.DefaultPhoto width="50" height="50" style="border-radius: 50%; margin:5px;" />
                    }
                    else
                    {
                        <img src="@item.Photo" width="50" height="50" style="border-radius: 50%; margin:5px;" />
                    }
                    
                    @item.FirstName
                </td>
                <td>@item.Surname</td>
                <td>@item.Email</td>
                <td>@item.Address</td>
                <td>
                    <a asp-action="Details" asp-route-surname="@item.Surname">View Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Pagination Controls -->
<div class="pagination-buttons">
    <button id="prevPage" onclick="prevPage()" disabled>Previous</button>
    <button id="nextPage" onclick="nextPage()">Next</button>
</div>

<script>
    // JavaScript Pagination
    var table = document.getElementById("clientTable");
    var rowsPerPage = 5; // Number of rows per page
    var currentPage = 1;
    var rows = Array.from(table.getElementsByTagName("tr"));
    var totalRows = rows.length;
    var totalPages = Math.ceil(totalRows / rowsPerPage);

    // Ensure the table has rows to display
    if (totalRows > 0) {
        displayPage(currentPage); // Display the first page initially
    }

    function displayPage(page) {
        // Hide all rows first
        rows.forEach(row => row.style.display = 'none');

        // Show only the rows for the current page
        var start = (page - 1) * rowsPerPage;
        var end = Math.min(start + rowsPerPage, totalRows);
        for (var i = start; i < end; i++) {
            rows[i].style.display = "table-row";
        }

        // Update button states
        document.getElementById("prevPage").disabled = (page === 1);
        document.getElementById("nextPage").disabled = (page === totalPages);
    }

    function nextPage() {
        if (currentPage < totalPages) {
            currentPage++;
            displayPage(currentPage);
        }
    }

    function prevPage() {
        if (currentPage > 1) {
            currentPage--;
            displayPage(currentPage);
        }
    }
</script>
