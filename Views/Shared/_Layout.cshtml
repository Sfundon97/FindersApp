@using Microsoft.AspNetCore.Identity
@using Finders.Models

@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Finders DB</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ASPNETCore_DB.styles.css" asp-append-version="true" />
    <!-- CSS only -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.0/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-gH2yIJqKdNHPEq0n4Mqa/HGKIhSkIHeL5AyhkYV8i59U5AR6csBvApHHNl/vI1Bx" crossorigin="anonymous">
    <style>
        html, body {
            height: 100%;
            margin: 0;
        }

        .wrapper {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .content {
            flex: 1;
        }
        .nav-item{
            font-weight: bold;
        }

    </style>
</head>
<body>
    <div class="wrapper">
        <header style="background-color: #8AB9EE; padding: 10px 0;">
            <div class="container">
                <nav class="navbar navbar-expand-sm" style="background-color: #8AB9EE;">
                    <div class="d-flex align-items-center">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            if (User.IsInRole("Admin"))
                            {
                                <a class="nav-link text-dark" asp-controller="Finders" asp-action="Details">
                                    <img src="~/images/finders.png" alt="Profile Icon" style="width: 50px; height: 50px; border-radius: 50%;" />
                                </a>
                            }
                            else
                            {
                                <a class="nav-link text-dark" asp-controller="Finders" asp-action="Index">
                                    <img src="~/images/finders.png" alt="Profile Icon" style="width: 50px; height: 50px; border-radius: 50%;" />
                                </a>
                            }
                        }
                        else
                        {
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">
                                <img src="~/images/finders.png" alt="Profile Icon" style="width: 50px; height: 50px; border-radius: 50%;" />
                            </a>
                        }

                        <a class="navbar-brand d-block ms-2" asp-controller="Home" asp-action="Index" style="font-size: 24px; font-weight: bold; color: #fff;">F<i class="fa-solid fa-person"></i>NDERS</a>
                    </div>

                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-end">
                        <ul class="navbar-nav flex-grow-1" style="align-items:center;">
                            
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Appointments" asp-action="Index">Appointments</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Client" asp-action="Index">Clients</a>
                            </li> 
                           
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="CIPC" asp-action="Index">CIPC</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="ServiceProvider" asp-action="Index">Service Providers</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="AboutUs">About</a>
                            </li>
                            <li class="nav-item" style="margin-right: 100px;">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Client" asp-action="FAQ">FAQs</a>
                            </li>
                            
                           
                            <partial name="_LoginPartial" />
                        </ul>
                    </div>
                </nav>
            </div>
        </header>

        <div class="container content">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>

        <footer class="border-top footer text-muted" style="background-color: #8AB9EE;color: whitesmoke;text-decoration: none; height:50px;">
            <div class="container">
                &copy; 2024 - F<i class="fa-solid fa-person"></i>nders | All Rights Reserved | 
                Follow Us:
                <a class="text-white text-decoration-none" href="https://www.facebook.com/CUTFreeState" target="_blank">
                    <i class="fa-brands fa-facebook" style="margin: 5px; font-size: 20px;"></i>
                </a>
                <a class="text-white text-decoration-none" href="https://www.twitter.com/cutfsonline" target="_blank">
                    <i class="fa-brands fa-twitter" style="margin: 5px; font-size: 20px;"></i>
                </a>
                <a class="text-white text-decoration-none" href="https://www.linkedin.com/school/central-university-of-technology-free-state/" target="_blank">
                    <i class="fa-brands fa-linkedin" style="margin: 5px; font-size: 20px;"></i>
                </a>
                <a class="contact" style="text-decoration: none; color:white; margin-left: 45%;" href="~/Contact.html">Contact Us</a>
            </div>
        </footer>
    </div>
    <!-- Add Firebase SDK scripts to your _Layout.cshtml or relevant HTML file -->
    <script src="https://www.gstatic.com/firebasejs/9.0.2/firebase-app.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.0.2/firebase-auth.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.0.2/firebase-firestore.js"></script>

    <script src="https://www.gstatic.com/firebasejs/9.0.2/firebase-app.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.0.2/firebase-auth.js"></script>
    <script>
        const firebaseConfig = {
            apiKey: "AIzaSyB1VfcMZg9QhMu-Xbx8uipRAlPy3qi8Bd8",
            authDomain: "findersmvc.firebaseapp.com",
            projectId: "findersmvc",
            storageBucket: "findersmvc.appspot.com",
            messagingSenderId: "1056042698190",
            appId: "1:1056042698190:web:67c08e4dd0c333af0d979f",
            measurementId: "G-SLMYWEZLK4"
        };
        firebase.initializeApp(firebaseConfig);
    </script>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <!-- JavaScript Bundle with Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.0/dist/js/bootstrap.bundle.min.js" integrity="sha384-A3rJD856KowSb7dwlZdYEkO39Gagi7vIsF0jrRAoQmDKKtQBHUuLZ9AsSv4jD4Xa" crossorigin="anonymous"></script>
    @await RenderSectionAsync("Scripts", required: false)
    @RenderBody()
    <script src="~/js/firebase-auth.js"></script>
</body>
</html>
