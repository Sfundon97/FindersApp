    Programmer name: S Nondwatyu
    Student nr: 220036624
    Assignment nr: GA1
    Purpose: This Razor view represents the home page of the Student Management System for Central University of Technology (CUT).
             It includes user information, a carousel showcasing images of the university, and a welcome section with upcoming activities.
-->
@{
    ViewData["Title"] = "Home";
}

<style>
    /* User info section */
    
    .user {
        margin-left: auto;
        padding: 20px;
        border: 1px solid #ddd;
        border-radius: 5px;
        background-color: #f5f5f5;
    }

        .user h1 {
            margin-bottom: 10px;
            font-size: 1.2em;
        }

    /* Main content section */
    .container-fluid {
        padding: 20px;
    }

    h1 {
        color: darkblue;
        text-align: center;
    }

    .border-bottom {
        border-bottom: 1px solid #ddd;
    }

    /* Welcome section */
    .welcome {
        margin-bottom: 30px;
    }

    h2 {
        margin-top: 0; 
    }

    .justify-content-evenly p {
        line-height: 1.5;
    }

    .btn-primary {
        background-color: #007bff;
        border-color: #007bff;
    }
   

    .activity-card {
        border: 1px solid #ddd;
        padding: 10px;
        margin-bottom: 15px;
        cursor: pointer;
        width: 1300px; 
        margin-left: auto;
        margin-right: auto;
        background-color: lightgray;
        
    }

        .activity-card:hover {
            background-color: #f5f5f5;
        }

    .activity-image {
        width: 100px;
        height: 100px;
        float: left;
        margin-right: 10px;
    }

    .fa-solid{
       
        font-size: 23px;
    }

    .activity-details {
        clear: both; 
    }

    .activity-title {
        font-weight: bold;
        margin-bottom: 5px;
    }


    /* footer style */
    .footer {
        position: sticky;
        bottom: 0;
        width: 100%;
        background-color: #f0f0f0;
    }

    .carousel-item img {
        object-fit: cover;
        transition: transform 0.8s ease-in-out;
    }

    .image-container {
        margin-left: 20%;
        width: 800px;
        height: 530px;
        overflow: hidden;
    }

</style>

<div class="user">
    <h1>User Logged In</h1>
    @*@<p>User Id: @ViewData["UserID"]</p>*@
    <p>User Name: @ViewData["UserName"]</p>
    <p>User Role: @ViewData["UserRole"]</p>
</div>


<div class="container-fluid border-bottom mb-3">
    <h2>Finders Management System</h2>
    <br />
</div>

<div id="carouselControls" class="carousel-slide" data-bs-ride="carousel" data-bs-interval="2000">

    <div class="carousel-inner">
        <div class="carousel-item active">
            <div class="image-container">
                <img src="~/images/findder1.jpeg" alt="Central University of Technology" />
            </div>
        </div>
        <div class="carousel-item">
            <div class="image-container">
                <img src="~/images/findder2.jpeg" alt="Central University of Technology" />
            </div>
        </div>
        <div class="carousel-item">
            <div class="image-container">
                <img src="~/images/finder3.jpeg" alt="Central University of Technology" />
            </div>
        </div>
    </div>
    
</div>



 
