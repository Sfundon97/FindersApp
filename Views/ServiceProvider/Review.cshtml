@model IEnumerable<Finders.Models.ServiceProvider>

@{
    ViewBag.Title = "Service Provider Reviews";
}

<style>
    /* Feedback container */
    .feedback-container {
        width: 60%;
        margin: 20px auto 75px;
        background-color: #87CEEB;
        border-radius: 20px;
        padding: 20px;
        text-align: center;
    }

        .feedback-container h3 {
            font-weight: bold;
            color: #333;
        }

    /* Feedback item styling */
    .feedback-item {
        padding: 20px;
        border-radius: 10px;
        background-color: transparent;
        color: #333;
        text-align: center;
    }

        .feedback-item img {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            margin-bottom: 10px;
        }

    .stars {
        font-size: 20px;
        color: #FFD700;
        margin: 5px 0;
    }

    .feedback-text {
        margin: 15px 0;
        font-size: 1em;
        color: #333;
    }

    /* No reviews message */
    .no-reviews {
        color: #666;
        font-style: italic;
    }

    /* Button styling */
    .button-container {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin-top: 20px;
    }

    .back-btn, .delete-btn {
        padding: 10px 20px;
        border-radius: 20px;
        font-weight: bold;
        text-transform: uppercase;
        cursor: pointer;
    }

    .back-btn {
        background-color: #B0BCC5;
        color: white;
        border: none;
    }

    .delete-btn {
        background-color: #FF3B30;
        color: white;
        border: none;
    }

    /* Confirmation popup styling */
    #confirmationPopup {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5);
        justify-content: center;
        align-items: center;
    }

    .popup-content {
        background-color: #C4C4C4;
        border-radius: 20px;
        padding: 20px;
        width: 300px;
        text-align: center;
    }
</style>

<div class="feedback-container">
    <h3>Feedback</h3>

    @if (Model.Any())
    {
        foreach (var review in Model)
        {
            <div class="feedback-item">
                <img src="~/images/DefaultPic.png" alt="Client Image" />

                <div class="stars">
                    @for (int i = 0; i < review.Ratings; i++)
                    {
                        <span>&#9733;</span>
                    }
                </div>

                <p><small>@review.Timestamp.ToString("MM/dd/yyyy hh:mm tt")</small></p>
                <p><strong>Username: </strong> @review.Username</p>
                <hr />
                <p class="feedback-text">@review.ReviewText</p>
                <hr />
                <div class="button-container">
                    <form asp-action="Index" method="get" class="d-inline">
                        <button type="submit" class="back-btn">&#8592; Back</button>
                    </form>
                    <button type="button" class="delete-btn" onclick="showConfirmation('@review.ClientId')">Delete</button>
                </div>
            </div>
            <hr style="border: dashed;" />
        }
    }
    else
    {
        <p class="no-reviews">No reviews available for this service provider.</p>
        <div class="button-container">
            <form asp-action="Index" method="get" class="d-inline">
                <button type="submit" class="back-btn">&#8592; Back</button>
            </form>
        </div>
    }
</div>

<!-- Confirmation Pop-up -->
<div id="confirmationPopup" style="display: none;">
    <div class="popup-content">
        <p style="font-weight: bold;">ARE YOU SURE YOU WANT TO DELETE THIS?</p>
        <hr style="border: 1px solid black; margin: 10px 0;">
        <div style="display: flex; justify-content: space-between;">
            <button onclick="hideConfirmation()" style="border: none; background: none; color: #4A5768; font-weight: bold;">NO</button>
            <div style="border-left: 1px solid black; height: 20px;"></div>
            <form asp-action="DeleteReview" method="post" id="deleteForm" class="d-inline">
                <input type="hidden" name="clientId" id="deleteClientId">
                <button type="submit" style="border: none; background: none; color: #FF3B30; font-weight: bold;">YES</button>
            </form>
        </div>
    </div>
</div>

<!-- Confirmation Popup Script -->
<script>
    function showConfirmation(clientId) {
        document.getElementById('confirmationPopup').style.display = 'flex';
        document.getElementById('deleteClientId').value = clientId; // Set the clientId value to the hidden input
    }

    function hideConfirmation() {
        document.getElementById('confirmationPopup').style.display = 'none';
    }
</script>


