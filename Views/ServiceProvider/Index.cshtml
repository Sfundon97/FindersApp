@model IEnumerable<Finders.Models.ServiceProvider>

@{
    ViewData["Title"] = "Service Providers";
}

<style>
    h2 {
        text-align: center;
        color: #333;
        margin-bottom: 30px;
    }

    .my-table {
        width: 100%;
        border-collapse: collapse;
        border-radius: 5px;
        overflow: hidden;
        box-shadow: 0px 0px 10px 0px rgba(0, 0, 0, 0.1);
    }

        .my-table th, .my-table td {
            padding: 15px;
            text-align: left;
            border-bottom: 1px solid #ddd;
        }

        .my-table th {
            background-color: gray;
            color: #fff;
        }

        .my-table tbody tr:nth-child(even) {
            background-color: #f2f2f2;
        }

        .my-table tbody tr:hover {
            background-color: #e9ecef;
        }

    .search-container {
        display: flex;
        justify-content: center;
        margin-bottom: 20px;
    }

    .search-input {
        padding: 10px;
        width: 300px;
        border: 1px solid #ddd;
        border-radius: 5px;
    }

    .search-button {
        padding: 10px 15px;
        margin-left: 10px;
        background-color: gray;
        color: white;
        border: none;
        border-radius: 5px;
        cursor: pointer;
    }

    .btn-back {
        padding: 10px 15px;
        margin-left: 10px;
        background-color: gray;
        color: white;
        border: none;
        border-radius: 5px;
        cursor: pointer;
    }

    .search-button:hover {
        background-color: #555;
    }

    /* Pagination buttons */
    .pagination-buttons {
        text-align: center;
        margin: 20px 0;
    }

        .pagination-buttons button {
            padding: 10px 20px;
            background-color: gray;
            color: white;
            border: none;
            margin: 0 5px;
            cursor: pointer;
            border-radius: 5px;
        }

            .pagination-buttons button[disabled] {
                background-color: lightgray;
                cursor: not-allowed;
            }
</style>

<h2>Service Provider Database</h2>

<!-- Search Form -->
<div class="search-container">
    <form asp-action="Index" method="get">
        <input type="text" name="searchCompany" class="search-input" placeholder="Search by Company" value="@ViewData["CurrentFilter"]" />
        <button type="submit" class="search-button">Search</button>
    </form>
    <form asp-action="Index" method="get">
        <button type="submit" class="btn-back">Back</button>
    </form>
</div>

<table class="table my-table">
    <thead>
        <tr>
            <th>Company Name</th>
            <th>Category</th>
            <th>Email</th>
            <th>Date Joined</th>
            <th>Reg. Number</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody id="serviceProviderTable">
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @if (!string.IsNullOrEmpty(item.Photo))
                    {
                        <img src="@item.Photo" alt="Service Provider Image" style="width: 100px; height: auto;" />
                    }
                    else
                    {
                        <img src="@item.DefaultPhoto" alt="Default Image" style="width: 100px; height: auto;" />
                    }
                    @item.CompanyName
                </td>
                <td>@item.Category</td>
                <td>@item.Email</td>
                <td>@item.DateJoined.ToShortDateString()</td>
                <td>@item.RegistrationNumber</td>
                <td>
                    
                    <button style="background-color:dodgerblue; color: white;border-radius:10%;">
                        <a asp-action="Details" asp-route-company="@item.CompanyName" style="border: none; background: none; color: white; font-weight: bold; text-decoration:none;">Services</a>
                    </button>
                    <button style="background-color:dodgerblue; color: white;border-radius:10%;">
                        <a asp-action="Review" asp-route-serviceProviderId="@item.ProviderId" style="border: none; background: none; color: white; font-weight: bold; text-decoration:none;">View Reviews</a>
                    </button>
                 

                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Pagination Controls -->
<div class="pagination-buttons">
    <button id="prevPage" onclick="prevPage()" disabled>Previous</button>
    <button id="nextPage" onclick="nextPage()">Next</button>
</div>

<script>
    // JavaScript Pagination
    var table = document.getElementById("serviceProviderTable");
    var rowsPerPage = 5;
    var currentPage = 1;
    var rows = table.getElementsByTagName("tr");
    var totalRows = rows.length;
    var totalPages = Math.ceil(totalRows / rowsPerPage);

    function displayPage(page) {
        // Hide all rows
        for (var i = 0; i < totalRows; i++) {
            rows[i].style.display = "none";
        }

        // Show the rows for the current page
        var start = (page - 1) * rowsPerPage;
        var end = page * rowsPerPage;
        for (var i = start; i < end && i < totalRows; i++) {
            rows[i].style.display = "table-row";
        }

        // Update button states
        document.getElementById("prevPage").disabled = (page === 1);
        document.getElementById("nextPage").disabled = (page === totalPages);
    }

    function nextPage() {
        if (currentPage < totalPages) {
            currentPage++;
            displayPage(currentPage);
        }
    }

    function prevPage() {
        if (currentPage > 1) {
            currentPage--;
            displayPage(currentPage);
        }
    }

    // Initial display
    displayPage(currentPage);
</script>
