@model Finders.Models.ForgotPassword

<h2 class="text-center">Forgot Password</h2>
@if (Model.EmailSent == true){
    <div>
        <p>The link has been sent to your email.</p>
    </div>
}
else
{
    <form asp-action="ForgotPassword" class="forgot-password-form mx-auto">
        <div class="form-group mb-3">
            <label for="email" class="form-label">Email Address</label>
            <input type="email" asp-for="Email" class="form-control" placeholder="Enter your email address" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div class="d-grid gap-2">
            <button type="submit" class="btn btn-primary btn-lg">Submit</button>
        </div>
    </form>
}
<div>
    <a asp-action="Login" asp-controller="Account">Login</a>
</div>


<!-- Custom styles -->
<style>
    .forgot-password-form {
        max-width: 400px;
        padding: 20px;
        border: 1px solid #ddd;
        border-radius: 10px;
        background-color: #f9f9f9;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

    h2.text-center {
        color: #7353be; /* Your header color */
    }
</style>
