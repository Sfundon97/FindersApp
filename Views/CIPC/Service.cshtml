@model Finders.Models.CIPCModel

@{
    ViewBag.Title = "Service Provider Services";
}

<style>


    .profile-container {
        width: 40%;
        display: flex;
        align-items: flex-start;
    }

        .profile-container img {
            width: 150px;
            height: 150px;
            background-color: #ccc;
            margin-right: 20px;
        }

    .profile-details {
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
    }

        .profile-details h2,
        .profile-details h3 {
            margin: 0;
            font-weight: bold;
        }

        .profile-details p {
            margin: 5px 0;
        }

    .stars {
        display: flex;
        align-items: center;
        font-size: 20px;
    }

        .stars span {
            color: #FFD700;
        }

    .reviews-link {
        color: blue;
        text-decoration: underline;
        cursor: pointer;
    }

    .appointment-links a {
        display: block;
        margin-top: 10px;
        color: black;
        text-decoration: none;
    }

    .feedback-container {
        width: 40%;
        background-color: #87CEEB;
        border-radius: 20px;
        padding: 20px;
    }

        .feedback-container h3 {
            text-align: center;
            font-weight: bold;
        }

    .feedback-item {
        display: flex;
        align-items: center;
        margin-top: 20px;
    }

        .feedback-item img {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            margin-right: 15px;
        }

        .feedback-item hr {
            width: 100%;
            border: 0.5px solid black;
        }

    .button-container {
        display: flex;
        justify-content: center;
        margin-top: 30px;
    }

    .back-btn {
        background-color: #B0BCC5;
        color: white;
        padding: 12px 24px;
        border-radius: 50px;
        border: none;
        font-weight: bold;
        cursor: pointer;
        text-transform: uppercase;
        display: flex;
        align-items: center;
    }

    #confirmationPopup {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5);
        z-index: 1000;
        justify-content: center;
        align-items: center;
    }

    .popup-content {
        background-color: #C4C4C4;
        border-radius: 20px;
        padding: 20px;
        width: 300px;
        text-align: center;
    }
</style>

<h1 style="text-align: center;">Feedback</h1>
<div class="profile-container">
    <img src="@Model.Photo" alt="Profile Image" style="max-width: 100%; height: auto; border-radius: 50%;" />
    <div class="profile-details">
        <h2>NOMONDE BEAUTY</h2>
        <h3>make up your mind</h3>
        <p>Bloemfontein, Willows</p>
        <p>Phone nr: @Model.</p>
        <p>Registration Nr:</p>
        <div class="stars">
            <span>&#9733;</span>
            <span>&#9733;</span>
            <span>&#9733;</span>
            <span>&#9733;</span>
            <span>&#9734;</span>
        </div>
        <p><a class="reviews-link">REVIEWS (151)</a></p>
        <div class="appointment-links">
            <a asp-action="Details" asp-route-company="@Model.CompanyName">View Details</a>
            <a asp-action="Index" asp-controller="Home">View Appointments>>></a>
        </div>
    </div>
</div>

<!-- Feedback Section -->
<div class="feedback-container">
    <h3>feedback</h3>
    <div class="feedback-item">
        <img src="~/images/DefaultPic.png" alt="Image from Firebase" style="max-width: 100%; height: auto;" />
        <p>John Mabanza</p>
    </div>
    <hr />
    <hr />
    <hr />
    <hr />
</div>

<div class="button-container" style="display: flex; gap: 100px;">
    <form asp-action="Index" method="get" class="d-inline">
        <button type="submit" class="back-btn" style="padding: 10px 20px; font-weight: bold; text-transform: uppercase;">
            &#8592; Back
        </button>
    </form>
    <button type="button" class="btn" style="background-color: #FF3B30; color: white; border: none; border-radius: 50px; padding: 10px 20px; font-weight: bold; text-transform: uppercase;" onclick="showConfirmation()">Delete</button>
</div>



<!-- Confirmation Pop-up -->
<div id="confirmationPopup">
    <div class="popup-content">
        <p style="font-weight: bold;">ARE YOU SURE YOU WANT TO DELETE THIS?</p>
        <hr style="border: 1px solid black; margin: 10px 0;">
        <div style="display: flex; justify-content: space-between;">
            <button onclick="hideConfirmation()" style="border: none; background: none; color: #4A5768; font-weight: bold;">NO</button>
            <div style="border-left: 1px solid black; height: 20px;"></div>
            <form asp-action="Delete" asp-route-company="@Model.CompanyName" method="post" class="d-inline">
                <button type="submit" style="border: none; background: none; color: #FF3B30; font-weight: bold;">YES</button>
            </form>
        </div>
    </div>
</div>

</div>

<!-- Confirmation Popup Script -->
<script>
    function showConfirmation() {
        document.getElementById('confirmationPopup').style.display = 'flex';
    }

    function hideConfirmation() {
        document.getElementById('confirmationPopup').style.display = 'none';
    }
</script>
