<!--
    Programmer name: S Nondwatyu
    Purpose: This Razor view represents the "Index" page, displaying a list of service provider records.
             It includes a search form to filter service providers by service provider Reg number, and a table displaying service provider information,
             including service provider Reg number, first name, surname, Date joined, photo, and email.
             Users can navigate through the paginated list and view details or delete specific student records.
-->
@model PaginatedList<Finders.Models.Finder>

@{
    ViewData["Title"] = "Database";
}
<!-- CSS styles for the page layout and elements -->
<style>
    body {
        background-color: #f8f9fa;
        font-family: Arial, sans-serif;
        
        margin-bottom: 150px;
    }

    

    h1 {
        text-align: center;
        color: #333;
        margin-bottom: 30px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    label {
        font-weight: bold;
    }

    input[type="text"] {
        width: 100%;
        padding: 10px;
        border-radius: 5px;
        border: 1px solid #ced4da;
        transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
    }

    input[type="submit"], .btn {
        display: inline-block;
        padding: 10px 20px;
        font-size: 16px;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        transition: background-color 0.3s;
    }

        input[type="submit"]:hover, .btn:hover {
            background-color: #007bff;
            color: #fff;
        }

    .table {
        width: 100%;
        border-collapse: collapse;
        border-radius: 5px;
        overflow: hidden;
        box-shadow: 0px 0px 10px 0px rgba(0,0,0,0.1);
    }

        .table th, .table td {
            padding: 15px;
            text-align: left;
            border-bottom: 1px solid #ddd;
        }

        .table th {
            background-color: gray;
            color: #fff;
        }

        .table tbody tr:nth-child(even) {
            background-color: #f2f2f2;
        }

        .table tbody tr:hover {
            background-color: #e9ecef;
        }

    .pagination {
        margin-top: 20px;
        text-align: center;
    }

        .pagination .btn {
            margin-right: 5px;
            border-radius: 20px;
            background-color: #007bff;
            color: #fff;
        }

            .pagination .btn:hover {
                background-color: #0056b3;
            }

            .pagination .btn.disabled {
                background-color: #dee2e6;
                cursor: not-allowed;
            }

                .pagination .btn.disabled:hover {
                    background-color: #dee2e6;
                }

            .pagination .btn.active {
                background-color: #0056b3;
            }

    img.student-photo {
        border-radius: 50%;
       
        max-width: 100px;
        height: auto;
        display: block;
        margin: 0 auto;
    }
</style>


<h1>Admin Database</h1>

<body>
 
<form asp-action="Index" method="get">
    <div class="form-actions no-color">
        <p>
            Search by Staff Number: <input type="text" name="SearchString" value="@ViewData["CurrentFilter"]" />
            <input type="submit" value="Search" class="btn btn-default" /> |
            <a asp-action="Index">Back</a>
        </p>
    </div>
</form>
<!--Admin data table-->
<table class="table">
    <thead>
        <tr>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewData["RegNumberSortParm"]"
                       asp-route-currentFilter="@ViewData["CurrentFilter"]" style="color: #fff;">Reg Number</a>
            </th>
            <th>
                First Name
            </th>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewData["NameSortParm"]"
                       asp-route-currentFilter="@ViewData["CurrentFilter"]" style="color: #fff; text-decoration:none;" >Surname</a>
            </th>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewData["DateSortParm"]"
                       asp-route-currentFilter="@ViewData["CurrentFilter"]" style="color: #fff;">Phone Number</a>
            </th>
            <th>
                Photo
            </th>
            <th>
                Email
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.RegNumber)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FirstName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Surname)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Phone)
            </td>
            <td width="25%">
                    <img src="@WebConstants.ImagePath@item.Photo" width="100" style="border-radius: 5px; border: 1px solid white" />
            </td>
            <td>
                @Html.DisplayFor(modelitem => item.Email)
            </td>
            <td>
                <a asp-action="Details" asp-route-id="@item.RegNumber">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.RegNumber">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>

@{
    var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
    var nextDisabled = !Model.HasNextPage ? "disabled" : "";
}

<a asp-action="Index"
   asp-route-sortOrder="@ViewData[" CurrentSort"]"
   asp-route-pageNumber="@(Model.PageIndex - 1)"
   asp-route-currentFilter="@ViewData[" CurrentFilter"]"
   class="btn btn-default @prevDisabled">
    Previous
</a>
<a asp-action="Index"
   asp-route-sortOrder="@ViewData[" CurrentSort"]"
   asp-route-pageNumber="@(Model.PageIndex + 1)"
   asp-route-currentFilter="@ViewData[" CurrentFilter"]"
   class="btn btn-default @nextDisabled">
    Next
</a>
</body>