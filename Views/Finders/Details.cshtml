<!--
    Programmer name: S Nondwatyu
    Purpose: This Razor view represents the "Details" page for displaying the details of a specific student record.
             It displays the admin's information including admin phone number, first name, surname, date joined, email, and photo.
             Users can navigate to the edit page to modify the details or return to the list of finders.
-->
@model Finders.Models.Finder

@{
    ViewData["Title"] = "Details";
}

<h2>Admin Details</h2>

<div>
    <hr />
    <dl class="row">
        <dd class="col-sm-10">
            <div class="col-4">

                <img src="@WebConstants.ImagePath/@Model.Photo" width="100" style="border-bottom-left-radius: 5px; border: 1px solid white; width: 80px; height: 80px; border-radius: 50%;" />
            </div>
        </dd>
        <dt class="col-sm-2">
            
        </dt>
        
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.RegNumber)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.RegNumber)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.FirstName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.FirstName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Surname)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Surname)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Phone)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Phone)
        </dd>
        
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Email)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Email)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.RegNumber">Edit Profile</a>
</div>
